
#include <WiFi.h>
#include <WebServer.h>

// Wi-Fi details
const char* ssid = "espTest";
const char* password = "123456789";

// Web server
WebServer server(80);

// LED pins
const int led1 = 4;
const int led2 = 16;
const int led3 = 17;

String getPage() {
  String html = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <title>ESP32 LED Control</title>
  <style>
    body {
      background: #111;
      color: white;
      text-align: center;
      font-family: Arial;
      padding: 25px;
    }

    button {
      width: 180px;
      height: 55px;
      font-size: 22px;
      margin: 8px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
    }

    .on {
      background: green;
      color: white;
    }

    .off {
      background: red;
      color: white;
    }
  </style>
</head>

<body>
  <h1>ESP32 LED Control</h1>

  <h2>LED 1</h2>
  <a href="/LED1ON"><button class="on">ON</button></a>
  <a href="/LED1OFF"><button class="off">OFF</button></a>

  <h2>LED 2</h2>
  <a href="/LED2ON"><button class="on">ON</button></a>
  <a href="/LED2OFF"><button class="off">OFF</button></a>

  <h2>LED 3</h2>
  <a href="/LED3ON"><button class="on">ON</button></a>
  <a href="/LED3OFF"><button class="off">OFF</button></a>
</body>
</html>
)rawliteral";

  return html;
}

void handleRoot() {
  server.send(200, "text/html", getPage());
}

void goHome() {
  server.sendHeader("Location", "/");
  server.send(303);
}

void setupServerRoutes() {
  server.on("/", handleRoot);

  server.on("/LED1ON", []() {
    digitalWrite(led1, HIGH);
    Serial.println("LED 1 ON");
    goHome();
  });

  server.on("/LED1OFF", []() {
    digitalWrite(led1, LOW);
    Serial.println("LED 1 OFF");
    goHome();
  });

  server.on("/LED2ON", []() {
    digitalWrite(led2, HIGH);
    Serial.println("LED 2 ON");
    goHome();
  });

  server.on("/LED2OFF", []() {
    digitalWrite(led2, LOW);
    Serial.println("LED 2 OFF");
    goHome();
  });

  server.on("/LED3ON", []() {
    digitalWrite(led3, HIGH);
    Serial.println("LED 3 ON");
    goHome();
  });

  server.on("/LED3OFF", []() {
    digitalWrite(led3, LOW);
    Serial.println("LED 3 OFF");
    goHome();
  });
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(led3, OUTPUT);

  digitalWrite(led1, LOW);
  digitalWrite(led2, LOW);
  digitalWrite(led3, LOW);

  Serial.println();
  Serial.println("Starting ESP32...");

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.disconnect(true);
  delay(1000);

  Serial.print("Connecting to Wi-Fi: ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED && attempts < 60) {
    delay(500);
    Serial.print(".");
    attempts++;
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("CONNECTED TO WIFI");
    Serial.print("ESP32 IP Address: ");
    Serial.println(WiFi.localIP());

    setupServerRoutes();

    server.begin();
    Serial.println("Web server started");
  } else {
    Serial.println("FAILED TO CONNECT");
    Serial.print("WiFi Status Code: ");
    Serial.println(WiFi.status());

    Serial.println("Check:");
    Serial.println("- Password is exactly correct");
    Serial.println("- Hotspot is 2.4 GHz");
    Serial.println("- Security is WPA2");
    Serial.println("- Hotspot is not hidden");
  }
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    server.handleClient();
  }
}

